@page "/patients"
@namespace MedicalCardsApp.Web.Components.Pages
@layout MainLayout
@inject IMedicalCardsService MedicalService
@rendermode InteractiveServer

<PageTitle>Пациенты</PageTitle>

<h1><i class="bi bi-people-fill"></i> Список пациентов</h1>

<div class="mb-3 d-flex justify-content-between align-items-center">
    <div class="input-group w-50">
        <input type="text" class="form-control" placeholder="Поиск пациента..." @bind="searchText" @oninput="FilterPatients" />
        <button class="btn btn-outline-secondary" type="button"><i class="bi bi-search"></i></button>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <i class="bi bi-plus-lg"></i> Добавить пациента
    </button>
</div>

@if (filteredPatients == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="mt-2">Загрузка данных...</p>
    </div>
}
else if (!filteredPatients.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Пациенты не найдены.
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded bg-white">
        <table class="table table-hover mb-0">
            <thead class="bg-danger text-white">
                <tr>
                    <th>ID</th>
                    <th>ФИО</th>
                    <th>Дата рождения</th>
                    <th>Возраст</th>
                    <th>Телефон</th>
                    <th>Email</th>
                    <th style="width: 200px;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in filteredPatients)
                {
                    <tr>
                        <td>@patient.Id</td>
                        <td class="fw-bold">@patient.FullName</td>
                        <td>@patient.DateOfBirth.ToString("dd.MM.yyyy")</td>
                        <td><span class="badge bg-secondary">@CalculateAge(patient.DateOfBirth) лет</span></td>
                        <td>@patient.Phone</td>
                        <td>@patient.Email</td>
                        <td>
                            <!-- Кнопка Подробнее -->
                            <button class="btn btn-sm btn-info me-2" @onclick="() => ViewPatientDetails(patient.Id)" title="Подробнее">
                                <i class="bi bi-eye"></i>
                            </button>
    
                            <!-- Кнопка Удалить -->
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(patient.Id, patient.FullName)" title="Удалить">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Модальное окно (оставьте как было) -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <a href="/patients/create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Добавить пациента
                </a>
                
                <EditForm Model="currentPatient" OnValidSubmit="SavePatient">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">ФИО Пациента <span class="text-danger">*</span></label>
                            <InputText @bind-Value="currentPatient.FullName" class="form-control" placeholder="Иванов Иван Иванович" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Дата рождения <span class="text-danger">*</span></label>
                            <InputDate @bind-Value="currentPatient.DateOfBirth" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Телефон</label>
                            <InputText @bind-Value="currentPatient.Phone" class="form-control" placeholder="+7 (999) 000-00-00" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="currentPatient.Email" class="form-control" placeholder="example@mail.ru" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-save"></i> Сохранить
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}
<!-- Модальное окно подтверждения удаления -->
@if (showDeleteConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">⚠️ Подтверждение удаления</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Вы действительно хотите удалить пациента <strong>@deletePatientName</strong>?</p>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Внимание!</strong> Будут также удалены:
                        <ul class="mb-0 mt-2">
                            <li>Все медицинские записи</li>
                            <li>Все приёмы и назначения</li>
                        </ul>
                    </div>
                    <p class="mb-0">Это действие нельзя отменить.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Отмена</button>
                    <button type="button" class="btn btn-danger" @onclick="ExecuteDelete">
                        <i class="bi bi-trash"></i> Да, удалить
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<Patient> patients = new List<Patient>();
    private IEnumerable<Patient> filteredPatients = new List<Patient>();
    private string searchText = "";
    private bool showModal = false;
    private Patient currentPatient = new Patient();
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        patients = await MedicalService.GetAllPatientsAsync();
        FilterPatients();
    }

    private void FilterPatients()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredPatients = patients;
        }
        else
        {
            filteredPatients = patients.Where(p =>
                p.FullName.ToLower().Contains(searchText.ToLower()) ||
                (p.Email != null && p.Email.ToLower().Contains(searchText.ToLower()))
            ).ToList();
        }
    }

    private void OpenCreateModal()
    {
        currentPatient = new Patient { DateOfBirth = DateTime.Now.AddYears(-20) };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SavePatient()
    {
        try
        {
            await MedicalService.CreatePatientAsync(currentPatient);
            successMessage = $"Пациент {currentPatient.FullName} успешно добавлен!";
            CloseModal();
            await LoadPatients();
        }
        catch (Exception ex)
        {
            successMessage = $"Ошибка: {ex.Message}";
        }
    }

    private void ViewPatientDetails(int id)
    {
        Navigation.NavigateTo($"/patients/{id}");
    }

    private async Task DeletePatient(int id)
    {
        await MedicalService.DeletePatientAsync(id);
        await LoadPatients();
    }

    private int CalculateAge(DateTime birthDate)
    {
        var today = DateTime.Today;
        var age = today.Year - birthDate.Year;
        if (birthDate.Date > today.AddYears(-age)) age--;
        return age;
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
    // Поля для подтверждения удаления
    private bool showDeleteConfirm = false;
    private int deletePatientId = 0;
    private string deletePatientName = string.Empty;

    // Показать подтверждение удаления
    private void ConfirmDelete(int id, string fullName)
    {
        deletePatientId = id;
        deletePatientName = fullName;
        showDeleteConfirm = true;
    }

    // Отмена удаления
    private void CancelDelete()
    {
        showDeleteConfirm = false;
        deletePatientId = 0;
        deletePatientName = string.Empty;
    }

    // Выполнить удаление
    private async Task ExecuteDelete()
    {
        try
        {
            await MedicalService.DeletePatientWithRecordsAsync(deletePatientId);
            showDeleteConfirm = false;
            await LoadPatients(); // Обновить список
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при удалении: {ex.Message}");
            // Можно добавить отображение ошибки пользователю
        }
    }

}