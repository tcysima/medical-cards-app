@page "/doctors/{id:int}"
@namespace MedicalCardsApp.Web.Components.Pages
@layout MainLayout
@inject IMedicalCardsService MedicalService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(doctor?.FullName ?? "Загрузка...")</PageTitle>

@if (doctor == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="mt-2">Загрузка данных...</p>
    </div>
}
else
{
    <div class="fade-in">
        <!-- Кнопка назад -->
        <div class="mb-3">
            <a href="/doctors" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Назад к списку
            </a>
        </div>

        <!-- Карточка врача -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-person-badge-fill"></i> Информация о враче</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>ID:</strong> @doctor.Id</p>
                        <p><strong>ФИО:</strong> @doctor.FullName</p>
                        <p><strong>Специальность:</strong> <span class="badge bg-primary">@doctor.Specialty</span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Стаж работы:</strong> @GetWorkExperience() лет</p>
                        <p><strong>Телефон:</strong> @(doctor.Phone ?? "Не указан")</p>
                        <p><strong>Всего приёмов:</strong> @appointments.Count()</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ближайшие приёмы -->
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="bi bi-calendar-check"></i> Ближайшие приёмы</h4>
                <span class="badge bg-light text-dark">@upcomingAppointments.Count() записей</span>
            </div>
            <div class="card-body">
                @if (!upcomingAppointments.Any())
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle"></i> Запланированных приёмов нет
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Дата и время</th>
                                    <th>Пациент</th>
                                    <th>Статус</th>
                                    <th>Контакты пациента</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in upcomingAppointments.OrderBy(a => a.ScheduledDate))
                                {
                                    <tr>
                                        <td>
                                            <strong>@appointment.ScheduledDate.ToString("dd.MM.yyyy")</strong><br />
                                            <small class="text-muted">@appointment.ScheduledDate.ToString("HH:mm")</small>
                                        </td>
                                        <td>
                                            <a href="/patients/@appointment.PatientId" class="text-decoration-none">
                                                @appointment.Patient?.FullName
                                            </a>
                                        </td>
                                        <td>
                                            @if (appointment.Status == "Запланирован")
                                            {
                                                <span class="badge bg-success">@appointment.Status</span>
                                            }
                                            else if (appointment.Status == "Завершён")
                                            {
                                                <span class="badge bg-secondary">@appointment.Status</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">@appointment.Status</span>
                                            }
                                        </td>
                                        <td>
                                            @if (appointment.Patient != null)
                                            {
                                                <div><i class="bi bi-telephone"></i> @appointment.Patient.Phone</div>
                                                <div><i class="bi bi-envelope"></i> @appointment.Patient.Email</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Статистика -->
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">Всего пациентов</h5>
                        <h2 class="display-4">@uniquePatients.Count()</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">Завершённых приёмов</h5>
                        <h2 class="display-4">@completedAppointments.Count()</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-info mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">Запланировано</h5>
                        <h2 class="display-4">@upcomingAppointments.Count()</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Doctor? doctor;
    private IEnumerable<Appointment> appointments = new List<Appointment>();
    private IEnumerable<Appointment> upcomingAppointments = new List<Appointment>();
    private IEnumerable<Appointment> completedAppointments = new List<Appointment>();
    private IEnumerable<Patient> uniquePatients = new List<Patient>();

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctorData();
    }

    private async Task LoadDoctorData()
    {
        doctor = await MedicalService.GetDoctorByIdAsync(Id);
        if (doctor != null)
        {
            var allAppointments = await MedicalService.GetAllAppointmentsAsync();
            appointments = allAppointments.Where(a => a.DoctorId == Id);
            upcomingAppointments = appointments.Where(a => a.Status == "Запланирован");
            completedAppointments = appointments.Where(a => a.Status == "Завершён");
            
            // Уникальные пациенты
            var patientIds = appointments.Select(a => a.PatientId).Distinct();
            var allPatients = await MedicalService.GetAllPatientsAsync();
            uniquePatients = allPatients.Where(p => patientIds.Contains(p.Id));
        }
    }

    private int GetWorkExperience()
    {
        // Предполагаем, что врач начал работать в 25 лет
        // Для демонстрации используем случайное значение 5-25 лет
        return new Random().Next(5, 25);
    }
}