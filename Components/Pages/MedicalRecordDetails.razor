@page "/medical-records/{id:int}"
@namespace MedicalCardsApp.Web.Components.Pages
@layout MainLayout
@inject IMedicalCardsService MedicalService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Запись #@record?.Id</PageTitle>

@if (record == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="mt-2">Загрузка данных...</p>
    </div>
}
else
{
    <div class="fade-in">
        <!-- Шапка -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-0"><i class="bi bi-file-earmark-medical-fill text-danger"></i> Медицинская запись #@record.Id</h1>
                <small class="text-muted">Дата: @record.RecordDate.ToString("dd.MM.yyyy")</small>
            </div>
            <a href="/medical-records" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Назад к списку
            </a>
        </div>

        <!-- Основные карточки -->
        <div class="row g-4 mb-4">
            <!-- Пациент -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-primary">
                    <div class="card-header bg-primary text-white d-flex align-items-center">
                        <i class="bi bi-person-circle fs-4 me-2"></i>
                        <h5 class="mb-0">Пациент</h5>
                    </div>
                    <div class="card-body">
                        <h4 class="card-title">@record.Patient?.FullName</h4>
                        <p class="mb-1"><strong>Возраст:</strong> @CalculateAge(record.Patient?.DateOfBirth ?? DateTime.Now) лет</p>
                        <p class="mb-1"><strong>Телефон:</strong> @record.Patient?.Phone</p>
                        <p class="mb-3"><strong>Email:</strong> @record.Patient?.Email</p>
                        <a href="/patients/@record.PatientId" class="btn btn-sm btn-outline-primary w-100">
                            <i class="bi bi-box-arrow-up-right"></i> Карта пациента
                        </a>
                    </div>
                </div>
            </div>

            <!-- Врач -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-success">
                    <div class="card-header bg-success text-white d-flex align-items-center">
                        <i class="bi bi-person-badge fs-4 me-2"></i>
                        <h5 class="mb-0">Врач</h5>
                    </div>
                    <div class="card-body">
                        <h4 class="card-title">@record.Doctor?.FullName</h4>
                        <p class="mb-2"><span class="badge bg-success">@record.Doctor?.Specialty</span></p>
                        <p class="mb-3"><strong>Телефон:</strong> @record.Doctor?.Phone</p>
                        <a href="/doctors/@record.DoctorId" class="btn btn-sm btn-outline-success w-100">
                            <i class="bi bi-box-arrow-up-right"></i> Профиль врача
                        </a>
                    </div>
                </div>
            </div>

            <!-- Диагноз и Лечение -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-danger">
                    <div class="card-header bg-danger text-white d-flex align-items-center">
                        <i class="bi bi-clipboard2-pulse fs-4 me-2"></i>
                        <h5 class="mb-0">Диагноз и Лечение</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <span class="badge bg-danger fs-6 p-2">@record.Diagnosis</span>
                        </div>
                        <div class="mb-3">
                            <h6 class="text-muted">Описание / Симптомы:</h6>
                            <p class="border-start border-4 border-primary ps-2 fst-italic">@record.Description</p>
                        </div>
                        <div>
                            <h6 class="text-muted">💊 Назначенное лечение:</h6>
                            <div class="alert alert-light border">
                                @(string.IsNullOrEmpty(record.Treatment) ? "Не указано" : record.Treatment)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- История пациента (Вкладки) -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> История пациента</h5>
            </div>
            <div class="card-body">
                <ul class="nav nav-tabs mb-3" id="historyTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="records-tab" data-bs-toggle="tab" data-bs-target="#records" type="button">Мед. записи</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="appointments-tab" data-bs-toggle="tab" data-bs-target="#appointments" type="button">Приёмы</button>
                    </li>
                </ul>
                <div class="tab-content">
                    <!-- Вкладка: Мед. записи -->
                    <div class="tab-pane fade show active" id="records">
                        @if (patientRecords.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Дата</th>
                                            <th>Диагноз</th>
                                            <th>Врач</th>
                                            <th>Лечение</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in patientRecords.OrderByDescending(x => x.RecordDate))
                                        {
                                            <tr class="@(r.Id == record.Id ? "table-warning" : "")">
                                                <td>@r.RecordDate.ToString("dd.MM.yyyy")</td>
                                                <td><span class="badge bg-secondary">@r.Diagnosis</span></td>
                                                <td>@r.Doctor?.FullName</td>
                                                <td><small>@(r.Treatment?.Length > 30 ? r.Treatment.Substring(0, 30) + "..." : r.Treatment)</small></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {

                            <p class="text-muted">Нет других записей.</p>
                        }
                    </div>

                    <!-- Вкладка: Приёмы -->
                    <div class="tab-pane fade" id="appointments">
                        @if (patientAppointments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Дата и время</th>
                                            <th>Врач</th>
                                            <th>Статус</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in patientAppointments.OrderByDescending(x => x.ScheduledDate))
                                        {
                                            <tr>
                                                <td>@a.ScheduledDate.ToString("dd.MM.yyyy HH:mm")</td>
                                                <td>@a.Doctor?.FullName</td>
                                                <td>
                                                    @if (a.Status == "Завершён")
                                                    {
                                                        <span class="badge bg-success">Завершён</span>
                                                    }
                                                    else
                                                    {

                                                        <span class="badge bg-warning text-dark">@(a.Status ?? "Запланирован")</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {

                            <p class="text-muted">Нет запланированных приёмов.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private MedicalRecord? record;
    private IEnumerable<MedicalRecord> patientRecords = new List<MedicalRecord>();
    private IEnumerable<Appointment> patientAppointments = new List<Appointment>();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        record = await MedicalService.GetMedicalRecordByIdAsync(Id);
        if (record != null)
        {
            patientRecords = await MedicalService.GetRecordsByPatientIdAsync(record.PatientId);
            patientAppointments = await MedicalService.GetAppointmentsByPatientIdAsync(record.PatientId);
        }
    }

    private int CalculateAge(DateTime birthDate)
    {
        var today = DateTime.Today;
        var age = today.Year - birthDate.Year;
        if (birthDate.Date > today.AddYears(-age)) age--;
        return age;
    }
}